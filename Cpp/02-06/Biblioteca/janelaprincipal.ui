   <string notr="true">/* Fundo da Janela */
QMainWindow {
    background-color: #0F172A; /* Slate escuro profundo */
}

/* Estilo dos Botões Gigantes */
QPushButton {
    background-color: #2563EB; /* Azul primário moderno */
    color: #FFFFFF;
    border: 1px solid #1D4ED8;
    border-radius: 12px; /* Cantos bem arredondados */
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* Efeito ao passar o mouse */
QPushButton:hover {
    background-color: #3B82F6;
    border: 1px solid #60A5FA;
}

/* Efeito ao clicar */
QPushButton:pressed {
    background-color: #1E40AF;
    border: 1px solid #1E3A8A;
}</string>
