  <property name="styleSheet">
   <string notr="true">/* Fundo da Janela */
QDialog {
    background-color: #0F172A;
}

/* Textos (Labels) */
QLabel {
    color: #94A3B8;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
}

/* Campos de Digitação */
QLineEdit {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
}

/* Efeito quando o campo está selecionado para digitar */
QLineEdit:focus {
    border: 2px solid #3B82F6;
    background-color: #0F172A;
}

/* --- BOTÃO GRAVAR (Verde Sucesso) --- */
#btn_gravar {
    background-color: #10B981; 
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 14px;
    padding: 10px;
}
#btn_gravar:hover { background-color: #34D399; }
#btn_gravar:pressed { background-color: #059669; }

/* --- BOTÃO CANCELAR (Cinza Secundário) --- */
#btn_cancelar {
    background-color: transparent;
    color: #CBD5E1;
    border: 1px solid #475569;
    border-radius: 6px;
    font-weight: bold;
    font-size: 14px;
    padding: 10px;
}
#btn_cancelar:hover { background-color: #1E293B; color: #FFFFFF; border: 1px solid #64748B; }
#btn_cancelar:pressed { background-color: #334155; }</string>
